<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">

<style>
@page {
    size: A4;
    margin: 20mm;
}

body {
    font-family: Arial, sans-serif;
    color: #2c2c2c;
    font-size: 12px;
}

/* CONTAINER CENTRAL A4 */
.page {
    width: 210mm;
    min-height: 297mm;
    margin: auto;
}

/* HEADER */
.header {
    display: flex;
    justify-content: space-between;
    border-bottom: 2px solid #000;
    padding-bottom: 10px;
}

.title {
    font-size: 20px;
    font-weight: bold;
}

.subtitle {
    font-size: 12px;
    color: #666;
}

/* SECTIONS */
.section {
    margin-top: 25px;
}

.section h2 {
    font-size: 14px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ddd;
    padding-bottom: 5px;
}

/* CARDS */
.cards {
    display: flex;
    gap: 10px;
}

.card {
    flex: 1;
    border: 1px solid #ddd;
    padding: 10px;
    border-radius: 6px;
}

.card span {
    display: block;
    font-size: 11px;
    color: #777;
}

.card strong {
    font-size: 14px;
}

/* TABLE */
table {
    width: 100%;
    border-collapse: collapse;
}

th {
    background: #000;
    color: #fff;
    padding: 8px;
    font-size: 11px;
}

td {
    padding: 8px;
    border-bottom: 1px solid #ddd;
}

/* FOOTER */
.footer {
    position: fixed;
    bottom: 10mm;
    left: 20mm;
    right: 20mm;
    font-size: 10px;
    color: #888;
    text-align: center;
}
</style>
</head>

<body>

<div class="page">

    <div class="header">
        <div>
            <div class="title">Relatório Geral</div>
            <div class="subtitle">{{empresa}}</div>
        </div>

        <div class="subtitle">
            Emitido em:<br>
            <strong>{{dataEmissao}}</strong>
        </div>
    </div>

    <div class="section">
        <h2>Financeiro</h2>
        <div class="cards">
            <div class="card">
                <span>Total</span>
                <strong>{{formatCurrency financeiro.total}}</strong>
            </div>
        </div>
    </div>

    <div class="section">
        <h2>Produtos</h2>
        <div class="cards">
            <div class="card">
                <span>Total</span>
                <strong>{{produtos.total}}</strong>
            </div>
            <div class="card">
                <span>Ativos</span>
                <strong>{{produtos.ativos}}</strong>
            </div>
        </div>
    </div>

    <div class="section">
        <h2>Top Produtos</h2>
        <table>
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {{#each topProdutos}}
                <tr>
                    <td>{{nome}}</td>
                    <td>{{total}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <div class="section">
        <h2>Produtos Zerados</h2>
        <table>
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Quantidade</th>
                </tr>
            </thead>
            <tbody>
                {{#each produtosZerados}}
                <tr>
                    <td>{{nome}}</td>
                    <td>{{quantidade}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

</div>

<div class="footer">
    Sistema EasyFood • Página 1
</div>

</body>
</html>